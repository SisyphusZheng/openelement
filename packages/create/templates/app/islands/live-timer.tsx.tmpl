/**
 * live-timer — client-only live stats island (compiled).
 *
 * hydrate: 'only' with ssr: false renders nothing on the server; the client
 * entry builds the DOM from the compiled Part Program and starts the clock in
 * connectedCallback, measured from the document's time origin.
 * disconnectedCallback stops the interval when the host leaves the tree.
 */
import { defineIslandConfig } from "@openelement/router";
import { element, OpenElement, property } from "@openelement/element";
import timerStyles from "./live-timer.css";

export const openElement = defineIslandConfig({ hydrate: "only", ssr: false, dsd: false });

// The interval handle rides compiled per-instance property state (module-level
// runtime statements are outside the compiled grammar, OEC9008).
@element("live-timer", { root: "shadow-open" })
export default class LiveTimer extends OpenElement {
  static override styles = [timerStyles];

  /** Elapsed seconds, preformatted: a compiled text Part binds a plain
   * property, never a method call (OEC9013). */
  @property({ reflect: false, attribute: false })
  elapsed = "0.0";

  /**
   * The ticking interval's handle; 0 when the host is not connected.
   *
   * `window.setInterval`, not the bare global: the generated tsconfig loads
   * both DOM and node types (@types/node), so the bare `setInterval` name
   * resolves to Node's overload and the handle becomes a `NodeJS.Timeout`
   * (TS2322 on the assignment). The browser entry runs in the DOM, where the
   * call returns a `number` — the honest type for this field.
   */
  @property({ reflect: false, attribute: false })
  interval = 0;

  override connectedCallback(): void {
    super.connectedCallback();
    this.interval = window.setInterval(() => {
      this.elapsed = (Math.round(performance.now()) / 1000).toFixed(1);
    }, 100);
  }

  override disconnectedCallback(): void {
    window.clearInterval(this.interval);
    this.interval = 0;
    super.disconnectedCallback();
  }

  render() {
    return (
      <div class="inline-flex items-baseline gap-[0.6rem]">
        <span
          id="elapsed"
          class="min-w-[6ch] text-right text-[1.4rem] font-semibold text-brand tabular-nums"
        >
          {this.elapsed}
        </span>
        <span class="text-[0.85rem] text-ink-soft">seconds on this page</span>
      </div>
    );
  }
}
