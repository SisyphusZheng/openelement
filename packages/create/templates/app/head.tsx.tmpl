/**
 * app/head.tsx — structural document-head content: the entries a URL list
 * cannot express (here, the color-scheme declaration).
 *
 * Entries are DATA and are emitted in the order written: `{ meta: {...} }` is
 * one meta tag, `{ link: { rel, href } }` one link tag, `{ style: 'css' }` one
 * inline style block. The build compiles this module, so it can import CSS by
 * URL and pull local constants — but it must not use host APIs: its output is
 * a build artifact.
 *
 * Title, description, favicon and the og:/twitter: pairs come from `head` in
 * openelement.config.ts. A route's own `head.meta` overrides a site default
 * with the same property; `name=` entries never suppress one. Delete this file
 * and the starter still builds — it is a convention, not a requirement.
 */
export default [
  // Declaring the color scheme the starter supports lets the browser pick the
  // right native form/scrollbar palette before any CSS is parsed. The dark
  // palette itself is theme.css's dark pair block — no runtime.
  { meta: { name: "color-scheme", content: "dark light" } },
];
