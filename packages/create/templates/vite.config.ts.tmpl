import { openElement } from "@openelement/router/vite";
import { defineConfig } from "vite";

// Vite configuration only: framework options live in openelement.config.ts,
// which the plugin reads itself, so the plugin call stays bare, and the JSX
// transform is owned by the plugin's compiler pass. `vite` is a direct
// devDependency pinned to the exact version @openelement/router resolves, so
// the tree carries one Vite copy; `oxfmt` / `oxlint` back the `fmt` / `lint`
// scripts and run with their defaults (markdown, JSON, YAML and CSS skipped).
export default defineConfig({
  base: "/",
  plugins: [...openElement()],
});
