// openelement.config.ts — framework options have exactly one home: this file.
//
// Every key is OPTIONAL; what it omits comes from a file convention:
//   tokens    app/styles/theme.css (the @theme role sheet, compiled through
//             the `tailwind` key below)
//   layout    app/layout.tsx (auto-registered; delete it and pages still
//             render their own chrome)
//   head      app/head.tsx (structural head entries; `head` below covers the
//             title/description/favicon/og pairs)
//   site name the "name" field of package.json
//
// The conventions follow `dirs`: give the app roots a shared leading directory
// and the conventions resolve under it too. Passing options inline to
// openElement() while this file carries options is a hard error — one home —
// and unknown keys are rejected with the accepted-key list.
import { defineConfig } from "@openelement/router";

export default defineConfig({
  // The Tailwind entry: the path is app-relative, and package CSS specifiers
  // such as '@openelement/ui/theme.css' work here too.
  tailwind: { theme: ["app/styles/theme.css"] },
  head: {
    // Overrides the package.json-name title fallback; page routes keep their
    // own `head: { title }`.
    title: "openElement Showcase",
    description: "A static-first openElement showcase — rendered before JavaScript arrives.",
    favicon: "/openelement-mark.svg",
  },
});
